# .env.example - copy to .env and fill in. Everything except GEMINI_API_KEY is optional.
# Never commit your real .env.

# --- Voice and Gemini (required for voice, text chat with Gemini models and web search) ---
# Google AI Studio API key
GEMINI_API_KEY=your-gemini-api-key
# Gemini Live model used for the voice session
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voice name and language of the spoken answers
GEMINI_VOICE=Algieba
GEMINI_LANGUAGE=en-US
# Model used by the web search tool
FRIDAY_SEARCH_MODEL=gemini-flash-latest
# Default models of the agent / chat roles (the UI settings override them)
FRIDAY_AGENT_MODEL=
FRIDAY_CHAT_MODEL=

# --- Optional: LiteLLM (OpenAI-compatible proxy) as an extra model provider ---
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=your-litellm-key

# --- Optional: memory service (REST API) behind the memory orbs, recall and remember ---
AGENTMEMORY_URL=http://localhost:3111
AGENTMEMORY_SECRET=your-memory-secret

# --- Optional: MCP client (see backend/mcp_servers.json) ---
# URL and bearer token of an MCP hub (streamable HTTP); the entry is disabled while the URL is empty
MCP_HUB_URL=https://mcp.example.com
MCP_HUB_TOKEN=your-mcp-hub-token
# Home Assistant MCP endpoint (URL without the /api/mcp path) and a long-lived access token
HA_URL=
HA_TOKEN=
# Path of another MCP config file ("" = no MCP servers at all)
# FRIDAY_MCP_CONFIG=/srv/data/mcp_servers.json

# --- Optional: Hermes agent (OpenAI-compatible API) for the ask_hermes tool ---
HERMES_URL=http://localhost:8642/v1
HERMES_KEY=your-hermes-key
HERMES_MODEL=hermes-agent
# Seconds to wait for a Hermes answer
HERMES_TIMEOUT=120

# --- Server ---
# Data directory (uploaded images, 3D models, preferences); /srv/data in the container
FRIDAY_DATA_DIR=/srv/data
# Directory with the built frontend; set by the Dockerfile
# STATIC_DIR=/srv/static
# 1 = enable the demo scenes sent by the "demo" message (development only)
FRIDAY_DEMO=0
# Version string; the Docker image sets it at build time, default is the backend __version__
# FRIDAY_VERSION=
